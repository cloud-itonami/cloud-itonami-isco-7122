;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a job-site scheduling/logistics coordination
;; robot for floor layers and tile setters (ISCO 7122) schedules the crew,
;; logs materials usage and progress, and coordinates tile/flooring supply
;; orders; it never lays floors or sets tiles itself. Its physical work is
;; materials delivery: bringing boxes of tile and bags of adhesive from the
;; delivery pallet to the room being tiled.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-7122"
 :cases
 [{:id :tile-box-destack
   :kind :manipulator
   :procedure "arm takes a box of floor tiles off the top of the delivery pallet and sets it down on the robot's cart deck"
   :params {:l1-m 0.60 :l2-m 0.55 :m1-kg 9.0 :m2-kg 6.0
            :from [0.55 0.95] :to [0.75 0.25] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [10.0 15.0 20.0 25.0 30.0]}
   :quantity :peak-tau1-nm
   :limit {:max 180.0 :basis "estimate: continuous shoulder torque of a ~20 kg-payload collaborative arm class"}
   :boundary {:lo 1.0 :hi 80.0}}
  {:id :tile-cart-corridor
   :kind :transport
   :procedure "delivery robot rolls a cart of tile boxes and adhesive bags 45 m along the corridor to the room being tiled"
   :params {:mass-kg 90.0 :distance-m 45.0 :v-max-mps 1.0 :a-max-mps2 0.6
            :brake-decel-mps2 1.0 :drive-force-n 250.0 :crr 0.02
            :cog-height-m 0.40 :support-half-length-m 0.35 :payload-cog-height-m 0.70}
   :sweep {:param :payload-kg :values [100.0 200.0 300.0 500.0 700.0]}
   :quantity :cycle-time-s
   :limit {:max 60.0 :basis "estimate: one delivery leg per minute keeps the tiling crew supplied at its laying rate"}
   :boundary {:lo 10.0 :hi 1100.0}}]}
